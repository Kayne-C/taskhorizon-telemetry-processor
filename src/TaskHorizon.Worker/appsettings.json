{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=taskhorizon;Username=taskhorizon;Password=taskhorizon-dev-only"
  },
  "TaskHorizon": {
    "Ingest": {
      "Partitions": 8,
      "EventsPerPartition": 1000000,
      "BatchSize": 50000,
      "DevicesPerPartition": 500,
      "MaxConcurrentCommits": 4
    },
    "Jobs": {
      "RollupIntervalSeconds": 30,
      "AlertIntervalSeconds": 15,
      "MaintenanceIntervalSeconds": 300,
      "MinuteRetentionDays": 7,
      "HourRetentionDays": 365
    }
  }
}
